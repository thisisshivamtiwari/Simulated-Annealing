flowchart TD
    A([Start]) --> B[Set parameters: pop_size, generations, crossover_rate, mutation_rate, penalty]
    B --> C["Initialize population: 1/3 greedy mutated + 2/3 random, apply Basic Repair to each"]
    C --> D["Evaluate all individuals: fitness = cost + penalty x violation"]
    D --> E[Track best feasible solution]
    E --> F[gen = 0]
    F --> G{gen < num_generations?}
    G -- No --> N{Best solution infeasible?}
    G -- Yes --> H["Create new population with elitism: keep best"]
    H --> I["Tournament Selection: select 2 parents"]
    I --> J{rand < crossover_rate?}
    J -- Yes --> K1["Single-Point Crossover -> 2 offspring"]
    J -- No --> K2[Copy parents as offspring]
    K1 --> L[Bit-Flip Mutation on each offspring]
    K2 --> L
    L --> M1[Basic Repair on each offspring]
    M1 --> M2[Add offspring to new population]
    M2 --> M3{Population full?}
    M3 -- No --> I
    M3 -- Yes --> D2[Evaluate new population]
    D2 --> E2[Update best feasible solution]
    E2 --> F2[gen++]
    F2 --> G
    N -- Yes --> O[Apply Heuristic Improvement to best]
    N -- No --> P[Return best solution]
    O --> P
    P --> Q([End])
